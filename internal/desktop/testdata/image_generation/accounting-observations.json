{
  "version": 1,
  "synthetic": true,
  "description": "记账观察四态（设计 6.4）。与文件/生成状态相互独立：自动结果默认 unverified；只有人工观察记录能把证据状态写成其他值，且文件状态不得覆盖它。observation 是脱敏的人工观察摘要（客户端本期不查询账单），null 表示没有观察。",
  "values": ["verified", "unverified", "ambiguous", "observed_mismatch"],
  "cases": [
    {
      "name": "succeeded_without_billing_record",
      "ledger": { "status": "succeeded" },
      "observation": { "window": "2026-11-10T08:00:00Z/2026-11-10T09:00:00Z", "visibleFields": ["tenant", "model", "time"], "candidates": [] },
      "expect": { "accountingStatus": "unverified" }
    },
    {
      "name": "save_failed_default",
      "ledger": { "status": "save_failed" },
      "observation": null,
      "expect": { "accountingStatus": "unverified" }
    },
    {
      "name": "unknown_default",
      "ledger": { "status": "unknown" },
      "observation": null,
      "expect": { "accountingStatus": "unverified" }
    },
    {
      "name": "cancelled_default",
      "ledger": { "status": "cancelled" },
      "observation": null,
      "expect": { "accountingStatus": "unverified" }
    },
    {
      "name": "billing_log_delayed",
      "ledger": { "status": "succeeded", "accountingStatus": "unverified" },
      "observation": { "window": "2026-11-10T08:00:00Z/2026-11-10T08:05:00Z", "visibleFields": ["tenant", "model", "time"], "candidates": [], "note": "账单延迟，窗口内未见记录" },
      "expect": { "accountingStatus": "unverified" }
    },
    {
      "name": "multiple_candidates",
      "ledger": { "status": "succeeded", "accountingStatus": "ambiguous" },
      "observation": { "window": "2026-11-10T08:00:00Z/2026-11-10T09:00:00Z", "visibleFields": ["tenant", "model", "time"], "candidates": ["acct-synthetic-a", "acct-synthetic-b"] },
      "expect": { "accountingStatus": "ambiguous" }
    },
    {
      "name": "unique_matching_record",
      "ledger": { "status": "succeeded", "accountingStatus": "verified" },
      "observation": { "window": "2026-11-10T08:00:00Z/2026-11-10T09:00:00Z", "visibleFields": ["tenant", "model", "time", "count"], "candidates": ["acct-synthetic-c"] },
      "expect": { "accountingStatus": "verified" }
    },
    {
      "name": "explicit_mismatch",
      "ledger": { "status": "save_failed", "accountingStatus": "observed_mismatch" },
      "observation": { "window": "2026-11-10T08:00:00Z/2026-11-10T09:00:00Z", "visibleFields": ["tenant", "model", "count"], "candidates": ["acct-synthetic-d", "acct-synthetic-e"], "note": "同一请求出现两条扣费（合成样例）" },
      "expect": { "accountingStatus": "observed_mismatch" }
    },
    {
      "name": "legacy_record_without_field",
      "ledger": { "status": "succeeded" },
      "observation": null,
      "expect": { "accountingStatus": "unverified" }
    },
    {
      "name": "unrecognized_value_is_not_verified",
      "ledger": { "status": "succeeded", "accountingStatus": "paid" },
      "observation": null,
      "expect": { "accountingStatus": "unverified" }
    }
  ]
}
