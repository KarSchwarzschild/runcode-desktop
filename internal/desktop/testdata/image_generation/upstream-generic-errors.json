{
  "version": 1,
  "synthetic": true,
  "description": "Core 未约定的失败（设计 6.3 第三行）。core 是 Core 对 Bridge 的合成响应（文本为合成样例，不是真实 Core 契约）；bridge 是 Bridge 对客户端的脱敏通用封装。客户端一律 unknown/generation_failed：不按文本推断额度/限流/内容原因，内部 401 不当成用户登录过期，零重发。",
  "genericMessage": "生成服务未返回可确认的结果，请联系管理员核查",
  "forbiddenClientText": ["额度", "限流", "内容审核", "quota", "rate", "Unauthorized", "<html", "X-Internal-Service-Key", "登录已失效"],
  "cases": [
    {
      "name": "core500_quota_like_text",
      "core": { "status": 500, "contentType": "text/plain; charset=utf-8", "body": "额度不足，请联系管理员充值（合成样例）" },
      "bridge": {
        "status": 502,
        "headers": { "Content-Type": "application/json", "X-Request-ID": "brg-synthetic-0201" },
        "body": { "error": { "code": "generation_failed", "message": "生成服务未返回可确认的结果，请联系管理员核查", "request_id": "brg-synthetic-0201" } }
      },
      "expect": { "status": "unknown", "code": "generation_failed", "requestId": "brg-synthetic-0201", "corePosts": 1, "retries": 0, "userAuthExpired": false }
    },
    {
      "name": "core500_rate_limit_like_text",
